# AutoPlanner backend configuration.
# Copy this file to backend/.env and fill in real values. backend/.env is gitignored — never commit it.

# REQUIRED. Web App URL of your deployed Apps Script (Deploy → Manage deployments → Web app URL, ends in /exec).
APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_YOUR_DEPLOYMENT_ID/exec

# REQUIRED. IANA timezone used for due dates and week grouping.
TIMEZONE=America/New_York

# OPTIONAL. Fallback Canvas token, used only when the UI does not send a per-student token
# on GET /api/assignments (X-Canvas-Token header). Leave blank in normal use (the teacher enters each student's token in the UI).
CANVAS_API_TOKEN=

# OPTIONAL. Fallback Canvas base URL (the UI sends canvas_base_url with each request).
CANVAS_BASE_URL=https://yourschool.instructure.com

# OPTIONAL. Comma-separated list of websites whose pages may call this API from a browser (CORS).
# Default: https://civicaiclub.github.io,http://127.0.0.1:8000,http://localhost:8000
ALLOWED_ORIGINS=
